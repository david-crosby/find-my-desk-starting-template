# DeskMate — Environment Variables
# Copy this file to .env and fill in the required values.
# Never commit .env to source control.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Anthropic API key for the Claude agent.
# Get yours at: https://console.anthropic.com
# The key starts with sk-ant-
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------

# SQLite database file path, relative to the directory where you run uv from.
# The data/ directory is created automatically by init_db.py.
DATABASE_URL=sqlite:///./data/deskmate.db

# ---------------------------------------------------------------------------
# SERVICE URLS
# Used by the UIs and the agent to reach each other.
# Change these if you run services on non-default ports.
# ---------------------------------------------------------------------------

BACKEND_URL=http://localhost:8000
AGENT_URL=http://localhost:8001

# ---------------------------------------------------------------------------
# MICROSOFT PLACES INTEGRATION (optional — mocked in the POC)
# Required only if you connect to a real Microsoft 365 E5 tenant.
# ---------------------------------------------------------------------------

AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ---------------------------------------------------------------------------
# SCHEDULING
# ---------------------------------------------------------------------------

# Time the nightly allocation engine runs (24-hour HH:MM).
ALLOCATION_RUN_TIME=23:00

# Cut-off time for marking no-shows and releasing desks.
CHECKIN_CUTOFF_TIME=10:00

# ---------------------------------------------------------------------------
# NOTIFICATIONS (optional)
# ---------------------------------------------------------------------------

# Webhook URL to send booking confirmation notifications.
# Leave blank to disable.
NOTIFICATION_WEBHOOK_URL=
